                <GradientStop Color="#0C1610" Offset="0.0"/>
                <GradientStop Color="#15241C" Offset="1.0"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="OrangePageBackground" StartPoint="1,0" EndPoint="0,1">
