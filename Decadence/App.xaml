<Application
    x:Class="Decadence.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Decadence">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Монотонная цветовая схема -->
            <Color x:Key="SurfaceColor">#F1EDE6</Color>
            <Color x:Key="BackgroundColor">#0F1A14</Color>
            <Color x:Key="TextColor">#E0F0E8</Color>
            <Color x:Key="TextSecondaryColor">#6B8E7E</Color>
            <Color x:Key="AccentColor">#2D8B6E</Color>

            <!-- Полуночный париж
            <Color x:Key="BackgroundColor">#0F0F1E</Color>
            <Color x:Key="TextColor">#F0F0F5</Color>
            <Color x:Key="TextSecondaryColor">#9B8B9F</Color>
            <Color x:Key="AccentColor">#6B4E71</Color> 
            -->

            <!-- Винный подвал
            <Color x:Key="BackgroundColor">#1E1518</Color>
            <Color x:Key="TextColor">#E8D5C4</Color>
            <Color x:Key="TextSecondaryColor">#9B766A</Color>
            <Color x:Key="AccentColor">#7D3C4A</Color>
            -->

            <!-- Морская глубина
            <Color x:Key="BackgroundColor">#0A1F24</Color>
            <Color x:Key="TextColor">#E8F4F8</Color>
            <Color x:Key="TextSecondaryColor">#6B8E99</Color>
            <Color x:Key="AccentColor">#2D8B9E</Color>
            -->

            <!-- Зеленый слоник
            <Color x:Key="BackgroundColor">#0F1A14</Color>
            <Color x:Key="TextColor">#E0F0E8</Color>
            <Color x:Key="TextSecondaryColor">#6B8E7E</Color>
            <Color x:Key="AccentColor">#2D8B6E</Color>
            -->

            <!-- Кобальт и медь
            <Color x:Key="BackgroundColor">#0D1B2A</Color>
            <Color x:Key="TextColor">#FFFFFF</Color>
            <Color x:Key="TextSecondaryColor">#7B8FA3</Color>
            <Color x:Key="AccentColor">#E07A5F</Color>
            -->

            <!-- Восточный бархат
            <Color x:Key="BackgroundColor">#1A0F0F</Color>
            <Color x:Key="TextColor">#F5E8E4</Color>
            <Color x:Key="TextSecondaryColor">#A38B86</Color>
            <Color x:Key="AccentColor">#C94B4B</Color>
            -->

            <!-- Алхимик
            <Color x:Key="BackgroundColor">#0A1414</Color>
            <Color x:Key="TextColor">#D4E8D4</Color>
            <Color x:Key="TextSecondaryColor">#6B8B6B</Color>
            <Color x:Key="AccentColor">#9B59B6</Color>
            -->

            <!-- Кооооосмооооос!
            <Color x:Key="BackgroundColor">#0B0C10</Color>
            <Color x:Key="TextColor">#C5D1E8</Color>
            <Color x:Key="TextSecondaryColor">#5A6A8A</Color>
            <Color x:Key="AccentColor">#4A90E2</Color>
            -->
            
            <!-- Кисти -->
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
            <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
            <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
            <SolidColorBrush x:Key="MiniPlayerBackgroundBrush" Color="{StaticResource TextColor}"/>
            <SolidColorBrush x:Key="PlaybackControlBrush" Color="{StaticResource AccentColor}"/>
            <SolidColorBrush x:Key="PlaybackControlForegroundBrush" Color="{StaticResource TextColor}"/>
            <SolidColorBrush x:Key="AppTitleBrush" Color="{StaticResource AccentColor}"/>
            <SolidColorBrush x:Key="MainBackgroundBrush" Color="{StaticResource BackgroundColor}"/>

            <!-- Заголовки -->
            <Style x:Key="TitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="42"/>
                <Setter Property="FontWeight" Value="Light"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="FontFamily" Value="Segoe UI Light"/>
            </Style>

            <!-- Обычный текст -->
            <Style x:Key="BodyTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Style>

            <!-- Вторичный текст -->
            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            </Style>

            <!-- Кнопки -->
            <Style x:Key="FlatButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Padding" Value="20,10"/>
            </Style>

            <Style x:Key="WhiteTextBoxStyle" TargetType="TextBox">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="FontFamily" Value="Segoe UI Light"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Padding" Value="12,0,12,0"/>
            </Style>
            
        </ResourceDictionary>
    </Application.Resources>
</Application>
