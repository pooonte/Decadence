<UserControl
    x:Class="Decadence.PlaylistsPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Storyboard x:Name="PanelOpenAnimation">
            <DoubleAnimation Storyboard.TargetName="RootGrid"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)"
                         From="80" To="0" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="6"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RootGrid"
                Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.2"/>
        </Storyboard>

        <Storyboard x:Name="PanelCloseAnimation">
            <DoubleAnimation Storyboard.TargetName="RootGrid"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)"
                         From="0" To="80" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseIn" Exponent="4"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RootGrid"
                Storyboard.TargetProperty="Opacity"
                         From="1" To="0" Duration="0:0:0.2"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}" x:Name="RootGrid" Visibility="Collapsed" Canvas.ZIndex="50">
        <Grid.RenderTransform>
            <CompositeTransform TranslateY="0"/>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Grid Grid.Row="0" Margin="16,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="плейлисты" 
                       Foreground="{StaticResource TextBrush}" 
                       FontSize="34" 
                       FontWeight="Light"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="✕"
                    Background="Transparent"
                    Foreground="{StaticResource TextBrush}"
                    FontSize="20"
                    HorizontalAlignment="Right"
                    Click="CloseButton_Click"/>
            <Button Grid.Column="1"
        Content="+"
        Background="Transparent"
        Foreground="{StaticResource TextBrush}"
        FontSize="24"
        HorizontalAlignment="Right"
        Click="CreatePlaylistButton_Click" Margin="0,0,46,0"/>
        </Grid>

        <!-- Список плейлистов -->
        <ListView x:Name="PlaylistsList"
                  ItemClick="Playlist_Click" 
                  IsItemClickEnabled="True"
                  Margin="0,65,0,0" Grid.RowSpan="2">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Height="50" Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Name}" 
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TrackCount}" 
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="⋮"
                                Background="Transparent"
                                Foreground="{StaticResource TextBrush}"
                                FontSize="20"
                                Click="PlaylistMenu_Click"
                                Tag="{Binding}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>