<UserControl
    x:Class="Decadence.FullButtonsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Storyboard x:Name="PanelOpenAnimation">
            <DoubleAnimation Storyboard.TargetName="RootGrid"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)"
                         From="80" To="0" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="6"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RootGrid"
                Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.2"/>
        </Storyboard>

        <Storyboard x:Name="PanelCloseAnimation">
            <DoubleAnimation Storyboard.TargetName="RootGrid"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)"
                         From="0" To="80" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseIn" Exponent="4"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RootGrid"
                Storyboard.TargetProperty="Opacity"
                         From="1" To="0" Duration="0:0:0.2"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}" x:Name="RootGrid" Visibility="Collapsed" Canvas.ZIndex="50" Grid.RowSpan="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="60"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.RenderTransform>
            <CompositeTransform TranslateY="0"/>
        </Grid.RenderTransform>

        <TextBlock Text="моя музыка" 
                   Foreground="{StaticResource TextBrush}" 
                   FontSize="34" 
                   FontFamily="Segoe UI" 
                   FontWeight="Light" 
                   HorizontalAlignment="Stretch" 
                   Margin="10,10,0,4" 
                   VerticalAlignment="Stretch"/>
        <Button x:Name="BackButton" Style="{StaticResource ImageButtonStyle}"
                                    Width="50"
                                    Height="50"
                                    Background="Transparent"
                                    Click="BackButton_Click" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Image Source="ms-appx:///Assets/prev_white.png" Margin="-10,-16,-20,-7" Width="60" Height="60" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Button>

        <TextBlock Text="Сотрировка" 
                   Foreground="{StaticResource TextBrush}" 
                   FontSize="24" 
                   FontFamily="Segoe UI" 
                   FontWeight="Light" 
                   HorizontalAlignment="Stretch" 
                   Margin="10,1,218,547" 
                   VerticalAlignment="Stretch" Grid.Row="1"/>
        <ComboBox x:Name="SortCombo"
              SelectedIndex="0"
              SelectionChanged="SortCombo_SelectionChanged"
              Background="Transparent"
              Foreground="{StaticResource TextBrush}"
              Width="172" Margin="178,1,0,0" Grid.Row="1" Height="37">
            <ComboBoxItem Content="По названию"/>
            <ComboBoxItem Content="По исполнителю"/>
            <ComboBoxItem Content="По альбому"/>
            <ComboBoxItem Content="По длительности"/>
        </ComboBox>
        <ListView x:Name="TracksListView" 
                  RightTapped="TracksListView_RightTapped"
                  Grid.Row="1" 
                  IsItemClickEnabled="True" Margin="0,38,0,0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Height="50" Margin="0,4">
                        <TextBlock TextWrapping="Wrap" Margin="16,0,16,0">
                            <Run Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="14"/>
                            <LineBreak />
                            <Run Text="{Binding Artist}" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                            <Run Text=" --- " Foreground="Gray" FontSize="12"/>
                            <Run Text="{Binding Album}" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>