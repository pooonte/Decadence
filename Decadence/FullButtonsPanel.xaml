<UserControl
    x:Class="Decadence.FullButtonsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BackgroundBrush}" x:Name="RootGrid" Visibility="Collapsed" Canvas.ZIndex="50" Grid.RowSpan="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="60"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Text="track list" 
                   Foreground="Black" 
                   FontSize="34" 
                   FontFamily="Segoe UI" 
                   FontWeight="Light" 
                   HorizontalAlignment="Stretch" 
                   Margin="10,10,0,4" 
                   VerticalAlignment="Stretch"/>
        <Button x:Name="BackButton"
                                    Width="50"
                                    Height="50"
                                    Background="Transparent"
                                    Click="BackButton_Click" HorizontalAlignment="Left" Margin="310,0,0,0" VerticalAlignment="Top">
            <Image Source="ms-appx:///Assets/prev.png" Margin="-10,-16,-20,-7" Width="60" Height="60" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Button>
        <ListView x:Name="TracksListView" 
                  Grid.Row="1" 
                  IsItemClickEnabled="True">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Height="50" Margin="0,4">
                        <TextBlock TextWrapping="Wrap" Margin="16,0,16,0">
                            <Run Text="{Binding Title}" Foreground="Black" FontSize="14"/>
                            <LineBreak />
                            <Run Text="{Binding Artist}" Foreground="Black" FontSize="12"/>
                            <Run Text=" --- " Foreground="Gray" FontSize="12"/>
                            <Run Text="{Binding Album}" Foreground="Black" FontSize="12"/>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>