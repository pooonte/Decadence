<UserControl
    x:Class="Decadence.AlbumsPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Storyboard x:Name="PanelOpenAnimation">
            <DoubleAnimation Storyboard.TargetName="RootGrid"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)"
                         From="80" To="0" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="6"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RootGrid"
                Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.2"/>
        </Storyboard>

        <Storyboard x:Name="PanelCloseAnimation">
            <DoubleAnimation Storyboard.TargetName="RootGrid"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)"
                         From="0" To="80" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseIn" Exponent="4"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RootGrid"
                Storyboard.TargetProperty="Opacity"
                         From="1" To="0" Duration="0:0:0.2"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}" x:Name="RootGrid" Visibility="Collapsed" Canvas.ZIndex="50" Grid.RowSpan="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="60"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.RenderTransform>
            <CompositeTransform TranslateY="0"/>
        </Grid.RenderTransform>
        
        <TextBlock Text="альбомы" 
                   Foreground="{StaticResource TextBrush}" 
                   FontSize="34" 
                   FontFamily="Segoe UI" 
                   FontWeight="Light" 
                   HorizontalAlignment="Stretch" 
                   Margin="10,10,0,4" 
                   VerticalAlignment="Stretch"/>
        <TextBlock x:Name="SelectedAlbumName"
                       Grid.Column="1"
                       Text="Альбомы"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="20"
                       VerticalAlignment="Top"
                       Margin="10,56,50,0"
                       Visibility="Collapsed"/>
        <Button x:Name="BackButton" Style="{StaticResource ImageButtonStyle}"
                                    Width="50"
                                    Height="50"
                                    Background="Transparent"
                                    Click="BackButton_Click" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Image Source="ms-appx:///Assets/prev_white.png" Margin="-10,-16,-20,-7" Width="60" Height="60" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Button>
        <ListView x:Name="AlbumsList" 
                  Grid.Row="1"
                  ItemClick="AlbumsList_ItemClick" 
                  IsItemClickEnabled="True" 
                  Background="Transparent"
                  Visibility="Visible" 
                  Margin="0,10,0,0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="16,8">
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="16"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding Artist}" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                            <TextBlock Text=" — " Foreground="Gray" FontSize="12"/>
                            <TextBlock Text="{Binding TrackCount}" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                            <TextBlock Text=" треков" Foreground="Gray" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Список песен альбома -->
        <Grid x:Name="AlbumSongsPanel" 
              Grid.Row="1"
              Visibility="Collapsed" 
              HorizontalAlignment="Stretch" 
              VerticalAlignment="Stretch">
            <ListView x:Name="AlbumSongsList"
                      Grid.Row="1"
                      ItemClick="AlbumSongsList_ItemClick"
                      IsItemClickEnabled="True"
                      Background="Transparent"
                      Margin="0,18,0,0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="50" Margin="16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                                       Text="{Binding TrackNumber}" 
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" 
                                           Foreground="{StaticResource TextBrush}" 
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Artist}" 
                                           Foreground="{StaticResource TextBrush}" 
                                           FontSize="12"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2" 
                                       Text="{Binding DurationString}" 
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="12"
                                       Margin="0,0,16,0"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>