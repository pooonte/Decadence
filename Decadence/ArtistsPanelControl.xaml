<UserControl
    x:Class="Decadence.ArtistsPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="White" Visibility="Visible" Canvas.ZIndex="50" Grid.RowSpan="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="60"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Text="artists" 
                   Foreground="Black" 
                   FontSize="34" 
                   FontFamily="Segoe UI" 
                   FontWeight="Light" 
                   HorizontalAlignment="Stretch" 
                   Margin="10,10,0,4" 
                   VerticalAlignment="Stretch"/>
        <TextBlock x:Name="SelectedArtistName"
                       Grid.Column="1"
                       Text="Исполнители"
                       Foreground="Black"
                       FontSize="20"
                       VerticalAlignment="Top"
                       Margin="10,56,50,0"
                       Visibility="Collapsed"/>
        <Button x:Name="BackToArtistsButton"
                                    Width="50"
                                    Height="50"
                                    Background="Transparent"
                                    Click="BackButton_Click" HorizontalAlignment="Left" Margin="310,0,0,0" VerticalAlignment="Top">
            <Image Source="ms-appx:///Assets/prev.png" Margin="-10,-16,-20,-7" Width="60" Height="60" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Button>
        <ListView x:Name="ArtistsList" 
                  Grid.Row="1"
                  ItemClick="ArtistsList_ItemClick" 
                  IsItemClickEnabled="True" 
                  Background="Transparent"
                  Visibility="Visible" 
                  Margin="0,1,0,0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="16,8">
                        <TextBlock Text="{Binding Name}" 
                                   Foreground="Black" 
                                   FontSize="16"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" (" 
                                   Foreground="Gray"
                                   FontSize="14"
                                   Margin="4,0,0,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TrackCount}" 
                                   Foreground="Gray"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=")" 
                                   Foreground="Gray"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid x:Name="ArtistSongsPanel" 
              Grid.Row="1"
              Visibility="Collapsed" 
              HorizontalAlignment="Stretch" 
              VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ListView x:Name="ArtistSongsList"
                      Grid.Row="1"
                      ItemClick="ArtistSongsList_ItemClick"
                      IsItemClickEnabled="True"
                      Background="Transparent"
                      Margin="0,18,0,0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="50" Margin="16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                                       Text="{Binding TrackNumber}" 
                                       Foreground="Gray"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" 
                                           Foreground="Black" 
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Album}" 
                                           Foreground="Gray" 
                                           FontSize="12"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2" 
                                       Text="{Binding DurationString}" 
                                       Foreground="Gray"
                                       FontSize="12"
                                       Margin="0,0,16,0"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>