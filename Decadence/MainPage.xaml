<Page
    x:Class="Decadence.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Decadence"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml" 
    mc:Ignorable="d" Foreground="{StaticResource BackgroundBrush}">
    <Grid x:Name="BackgroundContainer">
        <Canvas>
            <Image x:Name="PanoramaBackground"
               Source="Assets/panorama_bg.png"
               Stretch="UniformToFill"
               Opacity="0.35"
               ImageOpened="PanoramaBackground_ImageOpened">
                <Image.RenderTransform>
                    <CompositeTransform x:Name="PanoramaBackgroundTransform"/>
                </Image.RenderTransform>
            </Image>
        </Canvas>

        <Grid x:Name="MainContainer">
            <Grid.RowDefinitions>
                <RowDefinition Height="385*"/>
                <RowDefinition Height="383*"/>
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="MainPanorama"
                      Grid.RowSpan="2"
                      HorizontalScrollMode="Enabled"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalSnapPointsType="MandatorySingle"
                      HorizontalSnapPointsAlignment="Near"
                      ZoomMode="Disabled"
                      ViewChanged="MainPanorama_ViewChanged">
                <StackPanel x:Name="PanoramaSections" Orientation="Horizontal">
                    <Grid x:Name="HomeSection" Margin="0,0,0,0">
                    <Grid  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <TextBox x:Name="SearchBox" 
                 PlaceholderText="Поиск треков, исполнителей, альбомов"
                 TextChanged="SearchBox_TextChanged"
                 Margin="10,120,10,0" Height="35" VerticalAlignment="Top"/>

                        <!-- Результаты поиска -->
                        <ListView x:Name="SearchResults"
                  ItemClick="SearchResult_Click"
                  IsItemClickEnabled="True"
                  Visibility="Collapsed" Margin="0,170,0,0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="50" Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Artist}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Text="библиотека" 
                   FontSize="68" 
                   FontFamily="Segoe UI Light" 
                   FontWeight="Light"
                   Foreground="{StaticResource AppTitleBrush}"
                   Opacity="0.6"
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top" 
                   Margin="10,10,0,0"/>
                        <Grid x:Name="MainButtonsPanel" Visibility="Visible" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Button Content="моя музыка" 
                    FontSize="34" 
                    FontFamily="Segoe UI" FontWeight="Light"
                    Padding="0" 
                    BorderThickness="0" 
                    Background="Transparent" 
                    Foreground="{StaticResource TextBrush}" 
                    Margin="10,170,0,0" 
                    Click="TracksButton_Click" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top"/>

                            <Button Content="исполнители" FontSize="34" FontFamily="Segoe UI" FontWeight="Light" Padding="0" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextBrush}" Margin="10,220,0,0" Click="ArtistsButton_Click" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Button Content="альбомы" FontSize="34" FontFamily="Segoe UI" FontWeight="Light" Padding="0" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextBrush}" Margin="10,270,0,0" Click="AlbumsButton_Click" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Button Content="плейлисты" FontSize="34" FontFamily="Segoe UI" FontWeight="Light" Padding="0" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextBrush}" Margin="10,320,0,0" Click="PlaylistsButton_Click" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                            <Button Content="о приложении" 
                    FontSize="34" 
                    FontFamily="Segoe UI" FontWeight="Light" 
                    Padding="0" 
                    BorderThickness="0" 
                    Background="Transparent" 
                    Foreground="{StaticResource TextBrush}" 
                    Margin="10,370,0,0" 
                    Click="AboutButton_Click" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top"/>
                            <!-- 🔹 БЛОК СТАТИСТИКИ (Он же кнопка перехода в плеер) -->
                            <Button x:Name="StatsButton" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,10" Click="StatsButton_Click" Background="Transparent">
                                <StackPanel>
                                    <TextBlock Text="ВАША МУЗЫКА" 
                   FontSize="12" 
                   FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="ТРЕКИ: " 
                       FontSize="28" 
                       FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock x:Name="TrackCountNumber" 
                       Text="0" 
                       FontSize="28" 
                       FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <local:FullButtonsPanel x:Name="TracksPanelControl"
                                TrackClicked="TracksPanelControl_TrackClicked"
                                BackClicked="TracksPanelControl_BackClicked" Margin="0,-2,0,0"/>
                        <local:ArtistsPanelControl x:Name="ArtistsPanelControl"
                           ArtistClicked="ArtistsPanelControl_ArtistClicked"
                           TrackClicked="ArtistsPanelControl_TrackClicked"
                           BackClicked="ArtistsPanelControl_BackClicked" Margin="0,-2,0,0"/>
                        <local:AlbumsPanelControl x:Name="AlbumsPanelControl"
                          AlbumClicked="AlbumsPanelControl_AlbumClicked"
                          TrackClicked="AlbumsPanelControl_TrackClicked"
                          BackClicked="AlbumsPanelControl_BackClicked" Margin="0,-2,0,0"/>
                        <local:PlaylistsPanelControl x:Name="PlaylistsPanelControl"
                             PlaylistSelected="PlaylistsPanelControl_PlaylistSelected"
                             PlaylistEditRequested="PlaylistsPanelControl_PlaylistEditRequested"/>
                    </Grid>
                </Grid>
                    <Grid Margin="0,0,0,0" x:Name="SettingButtonsPanel">
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <TextBlock Text="настройки" 
                       FontSize="68" 
                       FontFamily="Segoe UI Light" 
                       FontWeight="Light"
                       Foreground="{StaticResource AppTitleBrush}"
                       Opacity="0.6"
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Top" 
                       Margin="10,10,0,0"/>
                            <TextBlock Text="Библиотеки" FontSize="25" FontFamily="Segoe UI" FontWeight="Light" Foreground="{StaticResource TextBrush}" Margin="10,105,211,500"/>
                            <TextBlock Text="При обновлении библиотеки приложение пересканирует все папки и найдет новые треки. Это может занять некоторое время." TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource TextBrush}" Margin="10,195,10,384"/>
                            <Button x:Name="RefreshLibraryButton" Content="Обновление библиотеки" Click="RefreshLibraryButton_Click" Height="45" Width="237" Padding="0" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextBrush}" BorderBrush="LightGray" FontSize="20" FontFamily="Segoe UI Light" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,145,113,0"/>

                            <TextBlock Text="Эксперименты" FontSize="25" FontFamily="Segoe UI" FontWeight="Light" Foreground="{StaticResource TextBrush}" Margin="10,261,180,342"/>
                            <TextBlock Text="Внимание! Здесь находятся экспериментальные функции, которые могут повлиять на опыт пользования приложением и на работоспособность устройства. Включать на свой страх и риск." TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource TextBrush}" Margin="10,303,10,255"/>
                        </Grid>
                    </Grid>
                    <Grid Margin="0,0,0,0" x:Name="OnlineButtonsPanel">
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <TextBlock Text="онлайн" 
                       FontSize="68" 
                       FontFamily="Segoe UI Light" 
                       FontWeight="Light"
                       Foreground="{StaticResource AppTitleBrush}"
                       Opacity="0.6"
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Top" 
                       Margin="10,10,0,0"/>
                            
                        </Grid>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
            <Frame x:Name="ContentFrame" Visibility="Collapsed"/>
            <ContentControl x:Name="MenuContent" Visibility="Collapsed" Background="{StaticResource BackgroundBrush}" Canvas.ZIndex="100" Margin="0,0,0,0" Grid.RowSpan="2"/>
        </Grid>
    </Grid>
</Page>
