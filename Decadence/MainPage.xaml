                        <ListView x:Name="PlaylistsList" Grid.Row="1" Margin="0,10,0,0"/>
                    </Grid>
                    <Grid x:Name="GenresPanel" VerticalAlignment="Bottom" Height="0"  Background="White"  Canvas.ZIndex="200">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Button Content="✕" Click="ClosePanel_Click" HorizontalAlignment="Right" Margin="10"/>
                        <ListView x:Name="GenresList" Grid.Row="1" Margin="0,10,0,0"/>
                    </Grid> -->
                </Grid>
            </PivotItem>
            <!-- <PivotItem>
                <Grid Margin="-12,-46,-12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="133*"/>
                        <RowDefinition Height="505*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Collection" Foreground="{StaticResource TextBrush}" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"/>
                    <ListView x:Name="TracksList" 
                              ItemClick="Track_ItemClick" 
                              IsItemClickEnabled="True"
                              Background="Transparent" Margin="0,47,0,0" HorizontalAlignment="Stretch" Grid.RowSpan="2" VerticalAlignment="Stretch">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="40" Margin="0,4">
                                    <TextBlock VerticalAlignment="Stretch"
                                               TextWrapping="Wrap"
                                               MaxWidth="280">
                                        <Run Text="{Binding Title}"
                                             Foreground="{StaticResource TextBrush}"
                                             FontSize="14"/>
