<Page
    x:Class="Decadence.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Decadence"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">
    <Grid x:Name="MainContainer">
        <Grid.RowDefinitions>
            <RowDefinition Height="385*"/>
            <RowDefinition Height="383*"/>
        </Grid.RowDefinitions>
        <Pivot x:Name="MainPivot" Margin="0,0,0,0" HeaderTemplate="{x:Null}" Grid.RowSpan="2" FontFamily="Segoe UI Light">
            <PivotItem Margin="0,0,0,0">
                <Grid Margin="0,-46,-13,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid x:Name="MenuTracksLayer" Margin="11,0,13,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Main Page" FontFamily="Segoe UI" FontWeight="Light" Foreground="{StaticResource AppTitleBrush}" FontSize="50"  HorizontalAlignment="Right"  VerticalAlignment="Top"  Margin="0,10,10,0"/>
                        <Button Content="tracks" 
                    FontSize="34" 
                    FontFamily="Segoe UI" FontWeight="Light"
                    Padding="0" 
                    BorderThickness="0" 
                    Background="Transparent" 
                    Foreground="{StaticResource TextBrush}" 
                    Margin="0,172,10,0" 
                    Click="TracksButton_Click" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Top"/>

                        <Button Content="about" 
                    FontSize="34" 
                    FontFamily="Segoe UI" FontWeight="Light" 
                    Padding="0" 
                    BorderThickness="0" 
                    Background="Transparent" 
                    Foreground="{StaticResource TextBrush}" 
                    Margin="0,179.667,10,0" 
                    Click="AboutButton_Click" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Top" Grid.Row="1"/>

                        <Button Content="settings" 
                    FontSize="34" 
                    FontFamily="Segoe UI" FontWeight="Light" 
                    Padding="0" 
                    BorderThickness="0" 
                    Background="Transparent" 
                    Foreground="{StaticResource TextBrush}" 
                    Margin="0,134.667,10,0" 
                    Click="SettingsButton_Click" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Top" Grid.Row="1"/>

                        <Button Content="artists" FontSize="34" FontFamily="Segoe UI" FontWeight="Light" Padding="0" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextBrush}" Margin="0,217,10,0" Click="ArtistsButton_Click" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        <!--<Button Content="albums" FontSize="34" FontFamily="Segoe UI" FontWeight="Light" Padding="0" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextBrush}" Margin="0,262,10,0" Click="AlbumsButton_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Grid.RowSpan="2"/>
                        <Button Content="playlists" FontSize="34" FontFamily="Segoe UI" FontWeight="Light" Padding="0" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextBrush}" Margin="0,89.667,10,0" Click="PlaylistsButton_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Grid.Row="1"/>
                        <Button Content="genres" FontSize="34" FontFamily="Segoe UI" FontWeight="Light" Padding="0" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextBrush}" Margin="0,44.667,10,0" Click="GenresButton_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Grid.Row="1"/>-->

                        <!-- Выдвижная панель для треков -->
                        <Grid x:Name="TracksPanel" Background="White" Visibility="Collapsed" Canvas.ZIndex="50" HorizontalAlignment="Stretch" Margin="0,0,0,0" Grid.RowSpan="2" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="track list" Foreground="Black" FontSize="34" FontFamily="Segoe UI Light" HorizontalAlignment="Stretch" Margin="10,10,0,588" Grid.RowSpan="2" VerticalAlignment="Stretch"/>
                            <ListView x:Name="TracksList" Grid.Row="1" ItemClick="Track_ItemClick" IsItemClickEnabled="True" Margin="0,56,0,0">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="50" Margin="0,4">
                                            <TextBlock TextWrapping="Wrap" Margin="16,0,16,0">
                                    <Run Text="{Binding Title}" Foreground="Black" FontSize="14"/>
                                    <LineBreak />
                                    <Run Text="{Binding Artist}" Foreground="Black" FontSize="12"/>
                                    <Run Text=" --- " Foreground="Gray" FontSize="12"/>
                                    <Run Text="{Binding Album}" Foreground="Black" FontSize="12"/>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                        <Grid x:Name="SettingsPanel"  Background="White" RequestedTheme="Light" Visibility="Collapsed" Canvas.ZIndex="50" HorizontalAlignment="Stretch" Margin="0,0,0,0" Grid.RowSpan="2" VerticalAlignment="Stretch">
                            <TextBlock Text="settings" Foreground="Black" FontSize="34" FontFamily="Segoe UI Light" HorizontalAlignment="Stretch" Margin="10,10,0,588" Grid.RowSpan="2" VerticalAlignment="Stretch"/>
                            <Pivot x:Name="SettingsPivot" Grid.Row="1" Margin="0,56,0,0">
                                <PivotItem Header="Library">
                                    <Grid Margin="10">
                                        <TextBlock Text="Update library" FontSize="20" FontFamily="Segoe UI Light" Foreground="Black" Margin="1,0,-1,20" SelectionChanged="TextBlock_SelectionChanged"/>
                                        <TextBlock Text="При обновлении библиотеки приложение пересканирует все папки и найдет новые треки. Это может занять некоторое время." TextWrapping="Wrap" FontSize="14" Foreground="Gray" Margin="1,53,-1,-53"/>
                                        <Button x:Name="RefreshLibraryButton" Content="Update" Click="RefreshLibraryButton_Click" Height="45" Width="120" Background="White" Foreground="Black" BorderThickness="1" BorderBrush="LightGray" FontSize="20" FontFamily="Segoe UI Light" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-10,10,0"/>
                                    </Grid>
                                </PivotItem>
                            </Pivot>
                        </Grid>
                        <Grid Margin="0,75,0,0" Grid.RowSpan="2">
                            <TextBox x:Name="SearchBox" Margin="10,48,0,0"
                                 PlaceholderText="search, please..."
                                 TextChanged="SearchBox_TextChanged"
                                 GotFocus="SearchBox_GotFocus"
                                 Background="White"
                                 Foreground="Black"
                                 Style="{StaticResource WhiteTextBoxStyle}"
                                 BorderThickness="1"
                                 FontFamily="Segoe UI" FontWeight="Light"
                                 FontSize="20"
                                 Padding="12,4"
                                 HorizontalAlignment="Left" VerticalAlignment="Top" Width="290" TextAlignment="Left"/>
                            <Grid Background="White" Visibility="Collapsed" x:Name="SearchPanel" HorizontalAlignment="Stretch" Margin="0,100,0,0" VerticalAlignment="Stretch">
                                <ListView x:Name="SearchResultsList"
                                      ItemClick="SearchResult_ItemClick"
                                      IsItemClickEnabled="True"
                                      Background="Transparent"
                                      Margin="0,8,0,0"
                                      Visibility="Collapsed">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="40" Margin="0,4">
                                                <TextBlock VerticalAlignment="Stretch"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="280">
                                                <Run Text="{Binding Title}"
                                                     Foreground="{StaticResource TextBrush}"
                                                     FontSize="14"/>
                                                <LineBreak />
                                                <Run Text="{Binding Artist}"
                                                     Foreground="{StaticResource TextSecondaryBrush}"
                                                     FontSize="12"/>
                                                <Run Text=" --- "
                                                     Foreground="{StaticResource TextSecondaryBrush}"
                                                     FontSize="12" FontFamily="Segoe UI" FontWeight="Light"/>
                                                <Run Text="{Binding Album}"
                                                     Foreground="{StaticResource TextSecondaryBrush}"
                                                     FontSize="12"/>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <StackPanel x:Name="EmptyStatePanel"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Visibility="Visible">
                                    <Image x:Name="SearchImage1"
                                       Source="ms-appx:///Assets/intelligence.png"
                                       Width="120" Height="68"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Visible">
                                        <Image.RenderTransform>
                                            <RotateTransform x:Name="Image1Rotation" Angle="0"/>
                                        </Image.RenderTransform>
                                    </Image>
                                    <TextBlock Text="О, вот и разведданные" 
                                           Foreground="{StaticResource AppTitleBrush}"
                                           x:Name="SearchBoxText"
                                           FontSize="16"
                                           Margin="0,20,0,0"
                                           HorizontalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                    <local:FullButtonsPanel x:Name="TracksPanelControl"
                                TrackClicked="TracksPanelControl_TrackClicked"
                                BackClicked="TracksPanelControl_BackClicked" Margin="11,0,13,0"/>
                    <local:ArtistsPanelControl x:Name="ArtistsPanelControl"
                           ArtistClicked="ArtistsPanelControl_ArtistClicked"
                           TrackClicked="ArtistsPanelControl_TrackClicked"
                           BackClicked="ArtistsPanelControl_BackClicked"/>
                </Grid>
            </PivotItem>
        </Pivot>
        <Frame x:Name="ContentFrame" Visibility="Collapsed"/>
        <ContentControl x:Name="MenuContent" Visibility="Collapsed" Background="{StaticResource BackgroundBrush}" Canvas.ZIndex="100" Margin="0,0,0,0" Grid.RowSpan="2"/>
    </Grid>
</Page>
