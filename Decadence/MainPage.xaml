<Page
    x:Class="Decadence.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Decadence"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0C1610" Offset="0.0"/>
            <GradientStop Color="#15241C" Offset="1.0"/>
        </LinearGradientBrush>
    </Page.Background>
    <Grid x:Name="MainContainer">
        <Grid.RowDefinitions>
            <RowDefinition Height="385*"/>
            <RowDefinition Height="383*"/>
        </Grid.RowDefinitions>
        <Pivot x:Name="MainPivot" Grid.RowSpan="2" HeaderTemplate="{x:Null}">
            <PivotItem Margin="0,0,0,0">
                <Grid Margin="0,-46,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TextBlock Text="библиотека" 
                   FontSize="68" 
                   FontFamily="Segoe UI Light" 
                   FontWeight="Light"
                   Foreground="{StaticResource AppTitleBrush}"
                   Opacity="0.6"
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top" 
                   Margin="10,10,0,0"/>
                    <Grid x:Name="MenuTracksLayer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Button Content="моя музыка" 
                    FontSize="34" 
                    FontFamily="Segoe UI" FontWeight="Light"
                    Padding="0" 
                    BorderThickness="0" 
                    Background="Transparent" 
                    Foreground="{StaticResource TextBrush}" 
                    Margin="10,120,0,0" 
                    Click="TracksButton_Click" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top"/>

                        <Button Content="о приложении" 
                    FontSize="34" 
                    FontFamily="Segoe UI" FontWeight="Light" 
                    Padding="0" 
                    BorderThickness="0" 
                    Background="Transparent" 
                    Foreground="{StaticResource TextBrush}" 
                    Margin="10,320,0,0" 
                    Click="AboutButton_Click" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top"/>

                        <Button Content="исполнители" FontSize="34" FontFamily="Segoe UI" FontWeight="Light" Padding="0" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextBrush}" Margin="10,170,0,0" Click="ArtistsButton_Click" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Button Content="альбомы" FontSize="34" FontFamily="Segoe UI" FontWeight="Light" Padding="0" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextBrush}" Margin="10,220,0,0" Click="AlbumsButton_Click" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Button Content="плейлисты" FontSize="34" FontFamily="Segoe UI" FontWeight="Light" Padding="0" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextBrush}" Margin="10,270,0,0" Click="PlaylistsButton_Click" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                        <!-- 🔹 БЛОК СТАТИСТИКИ (Он же кнопка перехода в плеер) -->
                        <Button x:Name="StatsButton" 
        HorizontalAlignment="Left" 
        VerticalAlignment="Bottom" 
        Margin="10,0,0,10" 
        Click="StatsButton_Click"
        Background="Transparent">

                            <StackPanel>
                                <TextBlock Text="ВАША МУЗЫКА" 
                   FontSize="12" 
                   FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="ТРЕКИ: " 
                       FontSize="28" 
                       FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock x:Name="TrackCountNumber" 
                       Text="0" 
                       FontSize="28" 
                       FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <local:FullButtonsPanel x:Name="TracksPanelControl"
                                TrackClicked="TracksPanelControl_TrackClicked"
                                BackClicked="TracksPanelControl_BackClicked"/>
                    <local:ArtistsPanelControl x:Name="ArtistsPanelControl"
                           ArtistClicked="ArtistsPanelControl_ArtistClicked"
                           TrackClicked="ArtistsPanelControl_TrackClicked"
                           BackClicked="ArtistsPanelControl_BackClicked"/>
                    <local:AlbumsPanelControl x:Name="AlbumsPanelControl"
                          AlbumClicked="AlbumsPanelControl_AlbumClicked"
                          TrackClicked="AlbumsPanelControl_TrackClicked"
                          BackClicked="AlbumsPanelControl_BackClicked"/>
                </Grid>
            </PivotItem>
            <PivotItem Margin="0">
                <Grid Margin="0,-46,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TextBlock Text="настройки" 
                   FontSize="68" 
                   FontFamily="Segoe UI Light" 
                   FontWeight="Light"
                   Foreground="{StaticResource AppTitleBrush}"
                   Opacity="0.6"
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top" 
                   Margin="10,10,0,0"/>

                    <Grid>
                        <TextBlock Text="Библиотеки" FontSize="20" FontFamily="Segoe UI" FontWeight="Light" Foreground="{StaticResource TextBrush}" Margin="10,105,211,503"/>
                        <TextBlock Text="При обновлении библиотеки приложение пересканирует все папки и найдет новые треки. Это может занять некоторое время." TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource TextBrush}" Margin="10,190,10,389"/>
                        <Button x:Name="RefreshLibraryButton" Content="Обновление библиотеки" Click="RefreshLibraryButton_Click" Height="45" Width="237" Padding="0" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextBrush}" BorderBrush="LightGray" FontSize="20" FontFamily="Segoe UI Light" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,140,94,0"/>

                    </Grid>
                </Grid>
            </PivotItem>
        </Pivot>
        <Frame x:Name="ContentFrame" Visibility="Collapsed"/>
        <ContentControl x:Name="MenuContent" Visibility="Collapsed" Background="{StaticResource BackgroundBrush}" Canvas.ZIndex="100" Margin="0,0,0,0" Grid.RowSpan="2"/>
    </Grid>
</Page>
