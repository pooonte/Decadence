<Page
    x:Class="Decadence.PlayerMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Decadence"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    
    <Page.Background>
        <StaticResource ResourceKey="MetroMagentaGradient"/>
    </Page.Background>
    <Grid>
        <Pivot>
            <PivotItem Margin="0,-48,0,0">
                <Grid>
                <TextBlock Text="сейчас играет" FontFamily="Segoe UI" FontWeight="Light" Foreground="{StaticResource AccentBrush}" FontSize="46"  HorizontalAlignment="Left"  VerticalAlignment="Top"  Margin="10,10,0,0"/>
                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,90,0,0" Height="300" Width="267">
                    <!-- Обложка -->
                        <Border BorderBrush="{StaticResource SecondBackgroundBrush}"
            Width="200" Height="200" HorizontalAlignment="Left" Margin="0,17,0,83">
                            <Image x:Name="FullAlbumArt" Stretch="UniformToFill"/>
                        </Border>
                        <!-- Инфо-блок (привязан к низу обложки) -->
                    <Grid HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Padding="20,18" MaxWidth="400">
                        <StackPanel>
                            <TextBlock x:Name="FullTrackTitle" 
                       Foreground="{StaticResource TextBrush}" 
                       FontSize="20" 
                       FontFamily="Segoe UI" 
                       FontWeight="Light" 
                       TextWrapping="Wrap" 
                       LineHeight="26" 
                       MaxHeight="52" 
                       Margin="0,0,0,6"/>

                            <TextBlock x:Name="FullTrackArtist" 
                       Foreground="{StaticResource TextBrush}" 
                       FontSize="14" 
                       FontFamily="Segoe UI" 
                       FontWeight="Light" 
                       Opacity="0.75"/>
                        </StackPanel>
                    </Grid>
                </Grid>
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="10,0,10,180">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="CurrentTimeText" Text="0:00" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                    <Slider Grid.Column="1" x:Name="ProgressSlider" Height="30" Margin="5,0,5,0" VerticalAlignment="Center" ManipulationMode="TranslateX" ManipulationStarted="ProgressSlider_ManipulationStarted" ManipulationCompleted="ProgressSlider_ManipulationCompleted">
                        <Slider.Background>
                            <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                                <GradientStop Color="#15241C" Offset="0"/>
                                <GradientStop Color="#E0E0E0" Offset="1"/>
                            </LinearGradientBrush>
                        </Slider.Background>
                        <Slider.Foreground>
                            <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                                <GradientStop Color="#00A0B1" Offset="0"/>
                                <GradientStop Color="#2E8DEF" Offset="0.14"/>
                                <GradientStop Color="#0A5BC4" Offset="0.28"/>
                                <GradientStop Color="#643EBF" Offset="0.42"/>
                                <GradientStop Color="#A700AE" Offset="0.57"/>
                                <GradientStop Color="#BF1E4B" Offset="0.71"/>
                                <GradientStop Color="#DC572E" Offset="0.85"/>
                                <GradientStop Color="#00A600" Offset="1"/>
                            </LinearGradientBrush>
                        </Slider.Foreground>
                    </Slider>

                    <!-- Время справа -->
                    <TextBlock Grid.Column="2" x:Name="TotalTimeText" Text="0:00" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" TextAlignment="Left"/>
                </Grid>
                <Grid x:Name="MenuSlidePanel" Width="250" HorizontalAlignment="Left" Background="{StaticResource BackgroundBrush}" Visibility="Collapsed" Canvas.ZIndex="200">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="SlidePanelTransform" X="0"/>
                    </Grid.RenderTransform>
                    <Button x:Name="CloseMenuPanelButton" HorizontalAlignment="Left" VerticalAlignment="Top" Width="40" Height="40" Background="Transparent" Click="CloseMenuPanel_Click">
                        <Image Source="ms-appx:///Assets/prev_white.png" Stretch="Uniform" Width="50" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-25,-21,-15,-11"/>
                    </Button>
                    <Button Content="Добавить в..." 
                    FontSize="30" 
                    FontFamily="Segoe UI" FontWeight="Light"
                    Padding="0" 
                    BorderThickness="0" 
                    Background="Transparent" 
                    Foreground="White" 
                    Margin="20,110,0,0" 
                    Click="AddToPlaylist_Click" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top"/>

                    <Button Content="О треке" 
                    FontSize="30" 
                    FontFamily="Segoe UI" FontWeight="Light" 
                    Padding="0" 
                    BorderThickness="0" 
                    Background="Transparent" 
                    Foreground="White" 
                    Margin="20,65,0,0" 
                    Click="TrackInfo_Click" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top"/>
                    <Button x:Name="RepeatButton" 
                    Background="Transparent" 
                    Foreground="White" 
                    FontFamily="Segoe UI" 
                    FontWeight="Light" 
                    Click="RepeatButton_Click" 
                    Margin="20,155,0,0"
                    Padding="0" Height="46"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top">
                        <Grid HorizontalAlignment="Left" Width="218" Margin="-12,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RepeatButtonText" 
                                               Grid.Column="0"
                                               Text="Зациклить" 
                                               FontFamily="Segoe UI" 
                                               FontWeight="Light" 
                                               FontSize="30"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left" Margin="10,0,0,0"/>
                            <Image x:Name="RepeatButtonImage" 
                                           Grid.Column="1"
                                           Source="ms-appx:///Assets/repeat_none_white.png" 
                                           Width="35" Height="35"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>
                        </Grid>
                    </Button>
                        <Button x:Name="ShuffleButton" 
        Click="ShuffleButton_Click" 
        Margin="20,206,0,394"
        Background="Transparent"
        Padding="0">
                            <TextBlock Text="Перемешать" 
               FontSize="30" 
               FontFamily="Segoe UI" 
               FontWeight="Light" 
               Foreground="White"/>
                        </Button>
                    </Grid>
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="103">
                    <Button x:Name="PrevButton" Click="PrevButton_Click" Background="Transparent" Style="{StaticResource ImageButtonStyle}" Foreground="{StaticResource AccentBrush}" FontSize="24" HorizontalAlignment="Left" Margin="-8,0,0,0" VerticalAlignment="Bottom" Height="76" Width="100" >
                        <Image x:Name="PrevButtonImage" Width="100" Height="100" Source="ms-appx:///Assets/prev_white.png"/>
                    </Button>
                    <Button x:Name="PlayPauseButton" Click="PlayPauseButton_Click" Background="Transparent" Style="{StaticResource ImageButtonStyle}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" Height="70" Width="80" Margin="177,0,103,0" >
                        <Image x:Name="FullPlayPauseIcon" Source="ms-appx:///Assets/play_white.png" Stretch="Uniform" Width="70" Height="70" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="NextButton" Click="NextButton_Click" Background="Transparent" Style="{StaticResource ImageButtonStyle}" Foreground="{StaticResource AccentBrush}" FontSize="24" HorizontalAlignment="Right" Margin="0" VerticalAlignment="Bottom" Height="76" Width="92">
                        <Image x:Name="NextButtonImage" Height="100" Width="100" Source="ms-appx:///Assets/next_white.png"/>
                    </Button>
                    <Button x:Name="MenuToggleButton" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource ImageButtonStyle}" Margin="97,0,0,0" Width="80" Height="70" Click="MenuToggleButton_Click" Foreground="{StaticResource AccentBrush}" BorderThickness="0">
                        <Image x:Name="MenuToggleImage" Source="ms-appx:///Assets/menu_white.png" Stretch="Uniform" Width="70" Height="70" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </Grid>
            </PivotItem>
            <PivotItem Margin="0,-48,0,0">
                <Grid>
                    <TextBlock Text="очередь" FontFamily="Segoe UI" FontWeight="Light" Foreground="{StaticResource AccentBrush}" FontSize="46"  HorizontalAlignment="Left"  VerticalAlignment="Top"  Margin="10,10,0,0"/>
                <ListView x:Name="QueueListView"
                  ItemClick="QueueListView_ItemClick"
                  IsItemClickEnabled="True"
                  Margin="0,80,0,0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="40" Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Index}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Title}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                </Grid>
            </PivotItem>
        </Pivot>

        <Button Style="{StaticResource ImageButtonStyle}" x:Name="BackToArtistsButton"
                                    Width="50"
                                    Height="50"
                                    Background="Transparent"
                                    Click="BackButton_Click" HorizontalAlignment="Right" Margin="0,0,0,0" VerticalAlignment="Top">
            <Image Source="ms-appx:///Assets/prev_white.png" Margin="0,-10,0,0" Width="60" Height="60" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Button>
    </Grid>

</Page>
