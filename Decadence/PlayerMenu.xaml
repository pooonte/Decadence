<Page
    x:Class="Decadence.PlayerMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Decadence"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid>
            <TextBlock Text="now playing" FontFamily="Segoe UI" FontWeight="Light" Foreground="{StaticResource AppTitleBrush}" FontSize="50"  HorizontalAlignment="Right"  VerticalAlignment="Top"  Margin="0,10,10,0"/>
            <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,100,0,0">
                <Border BorderBrush="Black"  BorderThickness="2"  Width="276"  Height="276">
                    <Grid>
                        <Image x:Name="FullAlbumArt" Width="272" Height="272" Stretch="UniformToFill"/>

                        <Border Height="6" VerticalAlignment="Top">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF000000" Offset="0"/>
                                    <GradientStop Color="#00000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border Height="6" VerticalAlignment="Bottom">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                    <GradientStop Color="#FF000000" Offset="0"/>
                                    <GradientStop Color="#00000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border Width="6" HorizontalAlignment="Left">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF000000" Offset="0"/>
                                    <GradientStop Color="#00000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border Width="6" HorizontalAlignment="Right">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                                    <GradientStop Color="#FF000000" Offset="0"/>
                                    <GradientStop Color="#00000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>

                <Grid VerticalAlignment="Bottom" Background="Black" Margin="-62,6,10,16" Padding="10,8" MaxWidth="200">
                    <StackPanel>
                        <TextBlock x:Name="FullTrackTitle" Foreground="White" FontSize="18" FontFamily="Segoe UI" FontWeight="Light" TextWrapping="Wrap" MaxWidth="250"/>
                        <TextBlock x:Name="FullTrackArtist" Foreground="Gray" FontSize="13" FontFamily="Segoe UI" FontWeight="Light" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="10,0,10,180">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="35"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="35"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="CurrentTimeText" Text="0:00" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                <Slider Grid.Column="1" x:Name="ProgressSlider" Height="30" Margin="5,0,5,0" VerticalAlignment="Center" ManipulationMode="TranslateX" ManipulationStarted="ProgressSlider_ManipulationStarted" ManipulationCompleted="ProgressSlider_ManipulationCompleted">
                    <Slider.Background>
                        <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                            <GradientStop Color="#E0E0E0" Offset="0"/>
                            <GradientStop Color="#E0E0E0" Offset="1"/>
                        </LinearGradientBrush>
                    </Slider.Background>
                    <Slider.Foreground>
                        <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                            <GradientStop Color="#00A0B1" Offset="0"/>
                            <GradientStop Color="#2E8DEF" Offset="0.14"/>
                            <GradientStop Color="#0A5BC4" Offset="0.28"/>
                            <GradientStop Color="#643EBF" Offset="0.42"/>
                            <GradientStop Color="#A700AE" Offset="0.57"/>
                            <GradientStop Color="#BF1E4B" Offset="0.71"/>
                            <GradientStop Color="#DC572E" Offset="0.85"/>
                            <GradientStop Color="#00A600" Offset="1"/>
                        </LinearGradientBrush>
                    </Slider.Foreground>
                </Slider>

                <!-- Время справа -->
                <TextBlock Grid.Column="2" x:Name="TotalTimeText" Text="0:00" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" TextAlignment="Left"/>
            </Grid>
            <Grid x:Name="MenuSlidePanel" Width="250" HorizontalAlignment="Left" Background="Black" Visibility="Collapsed" Canvas.ZIndex="200">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="SlidePanelTransform" X="0"/>
                </Grid.RenderTransform>
                <Button x:Name="CloseMenuPanelButton" HorizontalAlignment="Left" VerticalAlignment="Top" Width="40" Height="40" Background="Transparent" Click="CloseMenuPanel_Click">
                    <Image Source="ms-appx:///Assets/prev_white.png" Stretch="Uniform" Width="50" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-25,-21,-15,-11"/>
                </Button>
                <Button Content="Добавить в..." 
                    FontSize="30" 
                    FontFamily="Segoe UI" FontWeight="Light"
                    Padding="0" 
                    BorderThickness="0" 
                    Background="Transparent" 
                    Foreground="White" 
                    Margin="20,110,0,0" 
                    Click="AddToPlaylist_Click" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top"/>

                <Button Content="О треке" 
                    FontSize="30" 
                    FontFamily="Segoe UI" FontWeight="Light" 
                    Padding="0" 
                    BorderThickness="0" 
                    Background="Transparent" 
                    Foreground="White" 
                    Margin="20,65,0,0" 
                    Click="TrackInfo_Click" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top"/>
                <Button x:Name="RepeatButton" 
                    Background="Transparent" 
                    Foreground="White" 
                    FontFamily="Segoe UI" 
                    FontWeight="Light" 
                    Click="RepeatButton_Click" 
                    Margin="20,155,0,0"
                    Padding="0" Height="46"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top">
                    <Grid HorizontalAlignment="Left" Width="218" Margin="-12,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RepeatButtonText" 
                                               Grid.Column="0"
                                               Text="Зациклить" 
                                               FontFamily="Segoe UI" 
                                               FontWeight="Light" 
                                               FontSize="30"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left" Margin="10,0,0,0"/>
                        <Image x:Name="RepeatButtonImage" 
                                           Grid.Column="1"
                                           Source="ms-appx:///Assets/repeat_none_white.png" 
                                           Width="35" Height="35"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>
                    </Grid>
                </Button>
            </Grid>
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="103">
                <Button x:Name="PrevButton" Click="PrevButton_Click" Background="Transparent"  Foreground="{StaticResource AccentBrush}" FontSize="24" HorizontalAlignment="Left" Margin="-8,0,0,0" VerticalAlignment="Bottom" Height="76" Width="100" >
                    <Image x:Name="PrevButtonImage" Width="100" Height="100" Source="ms-appx:///Assets/prev.png" Margin="-10,-6,-10,-7"/>
                </Button>
                <Button x:Name="PlayPauseButton" Click="PlayPauseButton_Click" Background="Transparent" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" Height="70" Width="80" Margin="177,0,103,0" >
                    <Image x:Name="FullPlayPauseIcon" Source="ms-appx:///Assets/play.png" Stretch="Uniform" Width="70" Height="70" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button x:Name="NextButton" Click="NextButton_Click" Background="Transparent" Foreground="{StaticResource AccentBrush}" FontSize="24" HorizontalAlignment="Right" Margin="0" VerticalAlignment="Bottom" Height="76" Width="92">
                    <Image x:Name="NextButtonImage" Height="100" Width="100" Source="ms-appx:///Assets/next.png" Margin="-10,-6,-10,-7"/>
                </Button>
                <Button x:Name="MenuToggleButton" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="97,0,0,0" Width="80" Height="70" Click="MenuToggleButton_Click" Foreground="{StaticResource AccentBrush}" BorderThickness="0">
                    <Image x:Name="MenuToggleImage" Source="ms-appx:///Assets/menu.png" Stretch="Uniform" Width="70" Height="70" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <!--<Button x:Name="MenuButton" Foreground="Transparent" HorizontalAlignment="Left" Margin="222,104,0,0" VerticalAlignment="Top" Height="40" Width="40">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="О треке" Click="TrackInfo_Click"/>
                                        <MenuFlyoutItem Text="Добавить в..." Click="AddToPlaylist_Click"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                                <Image Source="ms-appx:///Assets/more.png" Height="40" Width="40" Margin="-10,-6,-10,-7" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </Button>
                            <Button x:Name="RepeatButton" Click="RepeatButton_Click" Background="Transparent" Height="40" Width="40" HorizontalAlignment="Left" Margin="97,104,0,0" VerticalAlignment="Top">
                                <Image x:Name="RepeatButtonImage" Source="ms-appx:///Assets/repeat_none.png" Height="40" Width="40" HorizontalAlignment="Stretch" Margin="-10,-6,-10,-7" VerticalAlignment="Stretch"/>
                            </Button>-->
            </Grid>

        </Grid>
    </Grid>

</Page>
